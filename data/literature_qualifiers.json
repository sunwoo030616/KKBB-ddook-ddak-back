{
  "version": "1",
  "scope": "Conservative necessary-presence heuristics for explicit request qualifiers. No paper IDs, semantic entailment or general language coverage claim.",
  "rules": [
    {
      "name": "financial_domain",
      "request": "금융|재무|financial|finance",
      "source": "financial|finance|finqa"
    },
    {
      "name": "wikipedia",
      "request": "위키피디아|wikipedia",
      "source": "wikipedia"
    },
    {
      "name": "conversational",
      "request": "여러\\s*턴|다중\\s*턴|대화형|multi[- ]?turn|conversational|이전\\s*(질문|계산).*이어",
      "source": "conversational|dialogue|multi[- ]?turn|turns"
    },
    {
      "name": "reflection_tokens",
      "request": "성찰.{0,12}토큰|reflection[- ]?tokens?",
      "source": "reflection.{0,25}tokens?|tokens?.{0,25}reflection"
    },
    {
      "name": "interleaved_actions",
      "request": "번갈|교대로|interleav|alternat",
      "source": "interleav|synergiz|reasoning.{0,50}acting"
    },
    {
      "name": "middle_context_position",
      "request": "긴.{0,15}(가운데|중간)|(가운데|중간).{0,15}문맥|middle.{0,15}context|context.{0,15}middle",
      "source": "middle"
    }
  ]
}
