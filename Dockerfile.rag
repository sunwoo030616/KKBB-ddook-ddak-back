FROM python:3.12-slim
WORKDIR /app
COPY requirements-rag.txt .
RUN pip install --no-cache-dir -r requirements-rag.txt && useradd --create-home appuser
COPY --chown=appuser:appuser rag_backend ./rag_backend
COPY --chown=appuser:appuser data ./data
RUN mkdir var && chown appuser:appuser var
USER appuser
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2)"
CMD ["uvicorn", "rag_backend.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
